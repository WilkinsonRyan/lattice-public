.DS_Store
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Local-only runtime state
lattice_data/logs/
lattice_data/*.sqlite-wal
lattice_data/*.sqlite-shm

# Never commit secrets
.env
*.pem
*.key
credentials*

# The database is machine-local and derived. Knowledge syncs as text via
# `lattice export` -> lattice_data/export/*.jsonl, which git can actually merge.
lattice_data/lattice.sqlite*

# Future ideas stay local until you decide one is ready to publish.
context/future-ideas/*.md
!context/future-ideas/README.md
!context/future-ideas/_TEMPLATE.md

# Action backups hold pre-change copies of files — including, by definition, the
# ones that held a credential. Never commit these.
lattice_data/backups/

# Capability token for the local digest server.
lattice_data/.digest-token
